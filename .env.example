# Plaid API Configuration
# Get these from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key
PLAID_ENV=sandbox  # sandbox, development, or production

# Optional: Webhook URL for real-time updates
PLAID_WEBHOOK_URL=https://your-app.com/webhooks/plaid

# Flask Configuration
FLASK_SECRET_KEY=your_random_secret_key_here

# Database Configuration (optional - defaults to SQLite)
DATABASE_URL=sqlite:///expense_tracker.db

# Email Configuration (required for user registration and password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Gmail App Password Setup:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account settings > Security > 2-Step Verification
# 3. Click "App passwords" and generate a new app password
# 4. Use that generated password (not your regular Gmail password) for MAIL_PASSWORD